{
  "name": "skills-installer",
  "version": "0.1.0",
  "description": "CLI for installing and managing agent skills",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.20.0"
  },
  "packageManager": "npm@11.19.0",
  "bin": {
    "skills-installer": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "ThirdPartyNoticeText.txt"
  ],
  "scripts": {
    "dev": "node --import tsx src/cli.ts",
    "build": "tsdown",
    "type-check": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "changeset": "changeset",
    "package:check": "publint --strict"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "commander": "15.0.0",
    "fast-string-width": "3.0.2",
    "tar": "7.5.22",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "22.20.5",
    "oxlint": "1.87.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
