.DS_Store

# Ignore work files before allowing skill resources that may use the same directory names.
**/.skills-installer/tmp/
**/.skills-installer/backups/
**/.skills-installer/operation.lock

# Project state and skill contents are shared, including resources matching rules above.
!**/.skills-installer/lock.json
!**/.skills-installer/skills/**
!**/.claude/skills/*
!**/.agents/skills/*
!**/.opencode/skills/*
!**/.pi/skills/*
!**/.cursor/skills/*
